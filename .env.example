# Environment configuration for EasyKnowledgeRetriever WebApp
# Copy to .env and fill in. NEVER commit .env.

# --- Application -------------------------------------------------------
EKR_DEBUG=false
EKR_WORKING_DIR=./rag_data
EKR_SOURCE_DIR=./documents

# Comma-separated list of extensions picked up by the ingestion scan.
# Only .pdf, .txt, .md and .markdown are actually supported by the library.
EKR_ALLOWED_EXTENSIONS=.pdf,.txt,.md

# Ingest documents automatically on startup. The API stays available while
# ingestion runs in the background; set to false to ingest out-of-band.
EKR_AUTO_INGEST=true

# Optional PDF page range (0-based, empty = whole document). Useful to measure
# ingestion cost on a slice before committing to a long document.
EKR_INGEST_START_PAGE=
EKR_INGEST_END_PAGE=

# Comma-separated allowed CORS origins. Leave empty (default) when the app is
# served same-origin behind nginx -- which is the case in the Docker image.
EKR_CORS_ORIGINS=

# Expose /docs, /redoc and /openapi.json. Keep false in production.
EKR_ENABLE_DOCS=false

# --- LLM ---------------------------------------------------------------
EKR_LLM_MODEL=gpt-4o
EKR_LLM_API_KEY=
EKR_LLM_BASE_URL=https://api.openai.com/v1

# --- Embeddings --------------------------------------------------------
# Changing the embedding model or dimension invalidates the whole index:
# you must rebuild rag_data/ from scratch.
EKR_EMBEDDING_MODEL=text-embedding-3-small
EKR_EMBEDDING_API_KEY=
EKR_EMBEDDING_BASE_URL=https://api.openai.com/v1
EKR_EMBEDDING_DIM=1536

# Wire format for embedding responses: base64 (OpenAI) or float. Many
# OpenAI-compatible gateways accept only float and answer 422 on base64,
# and the library records that failure on the document instead of raising --
# ingestion then reports success over an empty index.
EKR_EMBEDDING_ENCODING_FORMAT=base64

# --- Throughput (see library README) -----------------------------------
# Defaults are 1 = fully serialized = very slow on a large corpus.
# Raise to match your provider's rate limits.
EKR_MAX_ASYNC=4
EKR_EMBEDDING_MAX_ASYNC=4
EKR_EMBEDDING_BATCH_NUM=32
EKR_LLM_TIMEOUT=120
EKR_MINERU_TIMEOUT=3600

# --- Reranker (optional) -----------------------------------------------
# Cross-encoder rerank of retrieved chunks. NOTE: unlike the URLs above, this
# is the FULL endpoint, path included. Empty model = reranking disabled.
EKR_RERANKER_MODEL=
EKR_RERANKER_API_KEY=
EKR_RERANKER_BASE_URL=

# Generation temperature. 0 = the same question gets the same answer.
EKR_LLM_TEMPERATURE=0

# Entity extraction language and chunking. Applied on the next ingestion only.
EKR_LANGUAGE=French
EKR_CHUNK_TOKEN_SIZE=600
EKR_CHUNK_OVERLAP_TOKEN_SIZE=80
# Optional section marker: chunks never straddle it. Write a newline as \n.
# Legal texts: EKR_CHUNK_SPLIT_MARKER="\nArticle "
EKR_CHUNK_SPLIT_MARKER=

# --- Authentication (HTTP Basic, enforced by nginx) --------------------
# Both must be set to enable auth. Generate a real password, e.g.:
#   openssl rand -base64 24
# Leaving these empty DISABLES authentication entirely -- only acceptable
# when the app is not reachable from an untrusted network.
AUTH_USER=
AUTH_PASSWORD=

# --- Frontend ----------------------------------------------------------
APP_TITLE=EasyRAG
APP_SUBTITLE=Knowledge Retriever
# Interface language until the user picks one in the header (EN/FR button): en or fr.
APP_LANGUAGE=en
