# Environment configuration for EasyKnowledgeRetriever API

# Application
EKR_DEBUG=true
EKR_WORKING_DIR=./rag_data

# LLM Configuration (uncomment and set your keys)
# EKR_LLM_MODEL=gpt-4o
# EKR_LLM_API_KEY=your-openai-api-key
# EKR_LLM_BASE_URL=https://api.openai.com/v1

# Embedding Configuration
# EKR_EMBEDDING_MODEL=text-embedding-3-small
# EKR_EMBEDDING_API_KEY=your-embedding-api-key
# EKR_EMBEDDING_BASE_URL=https://api.openai.com/v1
# EKR_EMBEDDING_DIM=1536

